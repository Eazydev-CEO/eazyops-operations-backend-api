# EazyOps environment configuration
# Copy to .env and adjust. NEVER commit .env.

# --- Core ---------------------------------------------------------------
# Settings module: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate one: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins, required in production behind HTTPS, e.g. https://ops.example.com
CSRF_TRUSTED_ORIGINS=

# --- Database -----------------------------------------------------------
# Leave empty for SQLite (development default).
# PostgreSQL example: postgres://eazyops:password@localhost:5432/eazyops
DATABASE_URL=
# Persistent connections (seconds), production tuning
DB_CONN_MAX_AGE=60

# --- Email (SMTP) -------------------------------------------------------
# dev default is the console backend; set EMAIL_BACKEND=smtp in production
EMAIL_BACKEND=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EazyOps <no-reply@example.com>

# --- Security (production) ----------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_AGE=28800

# --- Application --------------------------------------------------------
# Base URL used in emails (invitation links, password resets)
SITE_URL=http://localhost:8000
# Invitation link lifetime in days
INVITATION_EXPIRY_DAYS=7
# Failed-login lockout: attempts within window -> lockout minutes
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Attachment upload cap in megabytes
MAX_UPLOAD_MB=10
# Days before due date to raise "due soon" notifications
JOB_DUE_SOON_DAYS=1
